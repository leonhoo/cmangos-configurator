{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cmangos-configurator",
  "version": "0.1.0",
  "identifier": "tech.hooo.tools.cmangos-configurator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:11420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cmangos-configurator",
        "width": 720,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}